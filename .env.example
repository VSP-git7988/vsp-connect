NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Records validated anonymous events and stores AI conversations,
# leads and usage. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- V2 AI business representative -----------------------------------------
# Server only. Without it the assistant is unavailable and profiles fall back
# to contact and booking actions.
ANTHROPIC_API_KEY=
# Provider registered in src/lib/ai/providers. Currently: anthropic.
AI_PROVIDER=anthropic
# Model id. Not the most expensive tier by default; raise deliberately.
AI_MODEL=claude-sonnet-5

# Abuse and cost controls. All optional; defaults shown.
AI_MAX_MESSAGE_LENGTH=1000
AI_MAX_MESSAGES_PER_CONVERSATION=25
AI_MAX_MESSAGES_PER_SESSION_HOUR=60
AI_MAX_MESSAGES_PER_PROFILE_MINUTE=30
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_OUTPUT_TOKENS=700
AI_KNOWLEDGE_LIMIT=6
AI_MAX_KNOWLEDGE_CHARS=6000
AI_DAILY_COST_LIMIT_USD=5
AI_REQUEST_TIMEOUT_MS=45000
